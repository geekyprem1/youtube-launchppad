# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key
# Default (fast) model used for most AI tasks
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
# Pro (powerful) model used for heavy tasks (channel audit, scripts, toolkit)
OPENROUTER_PRO_MODEL=google/gemini-2.5-flash
# Vision model for thumbnail analysis (supports images)
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# TTS model for Voice Studio (text-to-speech)
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m

# YouTube Data API
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# App URL (for OpenRouter referer header)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SiliconFlow API (For Thumbnail Engine Image Generation)
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
# Higher-tier SiliconFlow model for Clickbait Thumbnail Maker (falls back to SILICONFLOW_IMAGE_MODEL if unset)
SILICONFLOW_PRO_MODEL=your_higher_tier_siliconflow_model_id

# Replicate API (For Video Creation Engine Pro)
REPLICATE_API_TOKEN=your_replicate_api_token
# "owner/model" (latest version) or "owner/model:version_hash" (pinned version)
REPLICATE_VIDEO_MODEL=owner/model-name

# LaunchPadJV / external payment links (no in-app gateway)
# FE buy link (soft CTA for free users)
NEXT_PUBLIC_FE_URL=https://your-launchpadjv-fe-link
# OTO 1–12 product links (leave empty = "Link coming soon" on /upgrade)
NEXT_PUBLIC_OTO1_URL=
NEXT_PUBLIC_OTO2_URL=
NEXT_PUBLIC_OTO3_URL=
NEXT_PUBLIC_OTO4_URL=
NEXT_PUBLIC_OTO5_URL=
NEXT_PUBLIC_OTO6_URL=
NEXT_PUBLIC_OTO7_URL=
NEXT_PUBLIC_OTO8_URL=
NEXT_PUBLIC_OTO9_URL=
NEXT_PUBLIC_OTO10_URL=
NEXT_PUBLIC_OTO11_URL=
NEXT_PUBLIC_OTO12_URL=
